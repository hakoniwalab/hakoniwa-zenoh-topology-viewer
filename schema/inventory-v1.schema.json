{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hakoniwa.zenoh.inventory/v1",
  "type": "object",
  "required": ["schema", "targets"],
  "properties": {
    "schema": { "const": "hakoniwa.zenoh.inventory/v1" },
    "refresh_interval_ms": { "type": "integer", "minimum": 1 },
    "stale_after_ms": { "type": "integer", "minimum": 1, "default": 5000 },
    "endpoint_mux_config": { "type": "string", "minLength": 1 },
    "dynamic_targets": { "type": "boolean", "default": false },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "role"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "role": { "enum": ["router", "peer"] },
          "endpoint_config": { "type": "string", "minLength": 1 },
          "expected_zid": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "dynamic_targets": { "const": true } },
        "required": ["dynamic_targets"]
      },
      "then": {
        "required": ["endpoint_mux_config"],
        "properties": { "targets": { "maxItems": 0 } }
      },
      "else": {
        "properties": { "targets": { "minItems": 1 } }
      }
    }
  ],
  "additionalProperties": false
}
